# GeoSentinel Global Configuration Template

# Server Configuration
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Database Configuration (MySQL 8.x)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/geosentinel?useUnicode=true&characterEncoding=utf8mb4&serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root
FLYWAY_ENABLED=true

# Security & JWT
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
INTERNAL_SERVICE_KEY=geosentinel-internal-secret-token-2026

# Python AI Service
PYTHON_AI_BASE_URL=http://localhost:8000
AI_SERVICE_PORT=8000
MODEL_PROVIDER=local_fallback
LOCAL_MODEL_BASE_URL=http://localhost:11434

# Data Connectors
WORLD_BANK_BASE_URL=https://api.worldbank.org/v2
GDELT_BASE_URL=https://api.gdeltproject.org/api/v2
OONI_BASE_URL=https://api.ooni.io/api/v1
IODA_BASE_URL=https://api.ioda.inetintel.cc.gatech.edu/v2
USGS_BASE_URL=https://earthquake.usgs.gov/fdsnws/event/1
NASA_EONET_BASE_URL=https://eonet.gsfc.nasa.gov/api/v3
RELIEFWEB_BASE_URL=https://api.reliefweb.int/v1

# Session & Retention
SESSION_TTL_MINUTES=120
EVIDENCE_RETENTION_HOURS=24
